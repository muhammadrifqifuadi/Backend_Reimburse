APP_NAME=Reimburse API
# true HANYA untuk development lokal: tanpa SMTP, isi email (termasuk password sementara) ditulis ke log server.
# Di production biarkan false dan isi SMTP_* di bawah.
DEBUG=false
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/reimburse
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# WAJIB diganti di production
SECRET_KEY=ganti-dengan-string-acak-minimal-32-karakter
# Kunci enkripsi nomor rekening (Fernet). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Kebijakan umum
CLAIM_MAX_AGE_DAYS=30
RECEIPT_REQUIRED_ABOVE=50000

# Startup
AUTO_CREATE_TABLES=true

# Admin pertama (dipakai: python -m app.seed). Boleh dikosongkan; Anda akan ditanya saat menjalankannya.
# Setelah admin dibuat, hapus ADMIN_PASSWORD dari file ini.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Email: WAJIB di production. Password sementara user baru dan token lupa-password dikirim lewat email.
# Tidak perlu server email kantor: cukup SATU akun pengirim. Karyawan boleh memakai email pribadi apa pun sebagai penerima.
# Contoh Gmail (aktifkan Verifikasi 2 Langkah, lalu buat App Password di https://myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=alamat.pengirim@gmail.com
#   SMTP_PASSWORD=<App Password 16 karakter, tanpa spasi>
#   SMTP_FROM=alamat.pengirim@gmail.com   (harus sama dengan SMTP_USER)
# Uji dulu: python -m app.test_email alamat.tujuan@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@perusahaan.com
# Opsional: tautan di email. {token} diganti token reset (halaman frontend Anda yang memanggil POST /auth/reset-password).
FRONTEND_LOGIN_URL=
FRONTEND_RESET_URL=
